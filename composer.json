{
  "name": "rafaelthomas/laravel-architecture-guard",
  "description": "AST-based architectural dependency checks for Laravel and PHP projects.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "nikic/php-parser": "^5.0",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.0",
    "phpstan/phpstan": "^2.0",
    "laravel/pint": "^1.18"
  },
  "autoload": { "psr-4": { "ArchitectureGuard\\": "src/" } },
  "autoload-dev": { "psr-4": { "ArchitectureGuard\\Tests\\": "tests/" } },
  "extra": { "laravel": { "providers": ["ArchitectureGuard\\Laravel\\ArchitectureGuardServiceProvider"] } },
  "scripts": {
    "test": "pest",
    "analyse": "phpstan analyse",
    "format": "pint",
    "format:test": "pint --test",
    "check": ["@format:test", "@analyse", "@test"]
  },
  "config": { "sort-packages": true, "allow-plugins": { "pestphp/pest-plugin": true } },
  "minimum-stability": "stable",
  "prefer-stable": true
}
